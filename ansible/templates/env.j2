APP_ENV={{ app_env }}
APP_DEBUG={{ app_debug }}
APP_SECRET={{ app_secret }}
APP_HOST=0.0.0.0
APP_PORT=8080
IDP_EXTERNAL_HTTP_PORT={{ http_port }}
IDP_EXTERNAL_HTTPS_PORT={{ https_port }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db }}
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_DRIVER=pdo_pgsql
DATABASE_VERSION=16
DATABASE_URL=postgresql://{{ postgres_user }}:{{ postgres_password }}@db:5432/{{ postgres_db }}
SAMLIDP_HOSTNAME={{ idp_base_domain }}
SAMLIDP_TRUSTED_DOMAINS=
SAML_IDP_ENTITY_ID=https://{{ idp_tenant }}.{{ idp_base_domain }}:{{ https_port }}/saml2/idp/metadata.php
SAML_IDP_SSO_URL=https://{{ idp_tenant }}.{{ idp_base_domain }}:{{ https_port }}/saml2/idp/SSOService.php
SAML_IDP_CERT_PATH=/app/certs/idp.crt
SAML_IDP_KEY_PATH=/app/certs/idp.key
SAML_IDP_COMMON_NAME={{ idp_common_name }}
SEED_IDP_HOSTNAME={{ idp_tenant }}
DEFAULT_IDP_HOSTNAME={{ idp_tenant }}
SEED_IDP_USER_USERNAME=demo
SEED_IDP_USER_PASSWORD=demo123
SEED_IDP_USER_EMAIL=demo@example.org
SEED_IDP_USER_GIVEN_NAME=Demo
SEED_IDP_USER_SURNAME=User
SEED_IDP_USER_DISPLAY_NAME=Demo User
SEED_IDP_USER_AFFILIATION=member
SIMPLESAMLPHP_LOG_HANDLER={{ simplesaml_log_handler }}
SIMPLESAMLPHP_LOG_FILE={{ simplesaml_log_file }}
TRUSTED_PROXIES={{ trusted_proxies }}
MAILER_HOST=localhost
MAILER_PORT=1025
MAILER_USER=
MAILER_PASSWORD=
MAILER_ENCRYPTION=
MAILER_SENDER=noreply@example.org

# Entry point behavior
COMPOSER_INSTALL={{ composer_install }}
RUN_DB_MIGRATIONS={{ run_db_migrations }}
RUN_SCHEMA_UPDATE={{ run_schema_update }}
RUN_DB_SEED={{ run_db_seed }}
RUN_ADMIN_SEED={{ run_admin_seed }}
RUN_SYMFONY_BUILD={{ run_symfony_build }}

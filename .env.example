APP_ENV=dev
APP_DEBUG=1
APP_SECRET=ThisTokenIsNotSoSecretChangeItttt
APP_HOST=0.0.0.0
APP_PORT=8080
IDP_EXTERNAL_HTTP_PORT=8080
IDP_EXTERNAL_HTTPS_PORT=8443
POSTGRES_USER=samlidp
POSTGRES_PASSWORD=samlidp
POSTGRES_DB=samlidp
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_DRIVER=pdo_pgsql
DATABASE_VERSION=16
DATABASE_URL=postgresql://samlidp:samlidp@db:5432/samlidp
SAMLIDP_HOSTNAME=localhost
SAMLIDP_TRUSTED_DOMAINS=
SAML_IDP_ENTITY_ID=https://idpuni.localhost:8443/saml2/idp/metadata.php
SAML_IDP_SSO_URL=https://idpuni.localhost:8443/saml2/idp/SSOService.php
SAML_IDP_CERT_PATH=/app/certs/idp.crt
SAML_IDP_KEY_PATH=/app/certs/idp.key
SAML_IDP_COMMON_NAME=idpuni.localhost
SEED_IDP_HOSTNAME=idpuni
DEFAULT_IDP_HOSTNAME=
SEED_IDP_USER_USERNAME=demo
SEED_IDP_USER_PASSWORD=demo123
SEED_IDP_USER_EMAIL=demo@example.org
SEED_IDP_USER_GIVEN_NAME=Demo
SEED_IDP_USER_SURNAME=User
SEED_IDP_USER_DISPLAY_NAME=Demo User
SEED_IDP_USER_AFFILIATION=member
SIMPLESAMLPHP_LOG_HANDLER=file
SIMPLESAMLPHP_LOG_FILE=simplesamlphp.log
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
MAILER_HOST=localhost
MAILER_PORT=1025
MAILER_USER=
MAILER_PASSWORD=
MAILER_ENCRYPTION=
MAILER_SENDER=noreply@example.org
